{
  "name": "swift-package-registry",
  "version": "0.0.2",
  "private": true,
  "description": "A registry of Swift packages",
  "author": "step-security",
  "license": "ISC",
  "repository": "https://github.com/step-security/swift-package-registry.git",
  "homepage": "https://github.com/step-security/swift-package-registry#readme",
